#!/bin/sh

# System shutdown hook script for x728 UPS
# This script is called by systemd during system shutdown to simulate
# a button press and hold on the x728 UPS power button, which will
# terminate power to shut down the UPS.
#
# The script simulates: PRESS -> HOLD (10s)
# Note: Once power is terminated, the system loses power immediately,
# so no cleanup or release is needed or possible.

# cat /sys/kernel/debug/gpio

if [ "$1" = "poweroff" ] || [ "$1" = "halt" ]; then
    BUTTON=0

    if grep -aq "Pi 4" /proc/device-tree/model; then
        # Raspberry Pi 4: GPIO base 512 + pin 26 = 538
        BUTTON=538
    fi

    if grep -aq "Pi 5" /proc/device-tree/model; then
        # Raspberry Pi 5: GPIO base 571 + pin 26 = 597
        BUTTON=597
    fi

    if [ "$BUTTON" -eq 0 ]; then
        exit 0
    fi

    # Export GPIO pin (ignore error if already exported)
    echo "$BUTTON" > /sys/class/gpio/export 2>/dev/null

    # Configure as output
    if echo "out" > /sys/class/gpio/gpio$BUTTON/direction 2>/dev/null; then
        # PRESS: Set GPIO HIGH to simulate button press and hold
        # The x728 UPS control signal is active-high (HIGH = button pressed)
        echo "1" > /sys/class/gpio/gpio$BUTTON/value

        # HOLD: Keep HIGH for 10 seconds to trigger power termination
        # Note: Once UPS power is terminated, this system will lose power
        # immediately, so no cleanup is needed or possible
        /usr/bin/sleep 10
    fi
    # No cleanup needed - power will be cut by UPS before script completes
fi
