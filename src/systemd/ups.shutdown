#!/bin/sh

# System shutdown hook script for x728 UPS
# This script is called by systemd during system shutdown to simulate
# a button press and hold on the x728 UPS power button, which will
# terminate power to shut down the UPS.
#
# The script simulates: PRESS -> HOLD (2s) -> RELEASE
#
# The GPIO must be restored LOW after the press signal, otherwise the X728
# will require the onboard button to be pressed twice on next power-on,
# and the AUTO ON function will also be affected.
#
# Note: sysfs is used intentionally here — unlike libgpiod v2, sysfs holds
# pin state until explicitly changed, allowing the press/hold/restore sequence
# to work correctly even though power is cut during the hold period.

if [ "$1" = "poweroff" ] || [ "$1" = "halt" ]; then
    PIN=26

    if grep -aq "Pi 4" /proc/device-tree/model; then
        # Raspberry Pi 4: GPIO base is always 512
        BUTTON=$((512 + PIN))
    elif grep -aq "Pi 5" /proc/device-tree/model; then
        # Raspberry Pi 5: read RP1 GPIO base dynamically
        BASE=$(cat /sys/bus/platform/devices/1f000d0000.gpio/gpio/gpiochip*/base 2>/dev/null)
        if [ -n "$BASE" ]; then
            BUTTON=$((BASE + PIN))
        fi
    fi

    if [ -z "$BUTTON" ] || [ "$BUTTON" -eq 0 ]; then
        exit 0
    fi

    # Export GPIO pin (ignore error if already exported)
    echo "$BUTTON" > /sys/class/gpio/export 2>/dev/null

    # Configure as output
    if echo "out" > /sys/class/gpio/gpio${BUTTON}/direction 2>/dev/null; then
        # PRESS: Set GPIO HIGH to simulate button press
        echo "1" > /sys/class/gpio/gpio${BUTTON}/value

        # HOLD: Keep HIGH for 2 seconds
        # X728 will cut power during this window
        /usr/bin/sleep 2

        # RESTORE: Drive GPIO LOW for clean next boot
        # This step is necessary, otherwise you will have to press the onboard
        # button twice to turn on the device, and the AUTO ON function will
        # also be affected.
        # Note: sysfs holds this LOW state in hardware even after this script
        # exits, so the X728 sees a clean LOW state on next power-on.
        echo "0" > /sys/class/gpio/gpio${BUTTON}/value

        # WAIT: In case X728 takes longer to cut power
        /usr/bin/sleep 8
    fi
fi
